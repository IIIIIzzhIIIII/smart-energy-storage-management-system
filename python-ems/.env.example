# ============================================================
#  python-ems 环境变量模板
#  用法：复制本文件为 .env 并填入真实值，
#        该文件已被 .gitignore 忽略，不会被提交到仓库。
# ============================================================

# 和风天气 API Key（登录 console.qweather.com 获取）
WEATHER_API_KEY=你的和风天气APIKey

# 和风天气「个人专属 API Host」，留空则使用公共 Host
WEATHER_API_HOST=https://你的专属host.qweatherapi.com
